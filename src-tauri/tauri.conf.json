{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Schalttafel",
  "version": "1.0.0",
  "identifier": "de.sauck.schalttafel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Schalttafel",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Markus Sauck",
    "shortDescription": "Soundboard im 50er-Jahre-Schalttafel-Look",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["German"], "installMode": "currentUser" },
      "wix": { "language": "de-DE" }
    }
  }
}
